# --- Required -------------------------------------------------------------
# Password for the admin panel.
ADMIN_PASSWORD=change-me
# Signs login sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Optional -------------------------------------------------------------
# Where the SQLite database and images are stored (default ./data)
# DATA_DIR=./data
# Use a remote libSQL/Turso database instead of the local file
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Facebook Graph API version
# FB_GRAPH_VERSION=v23.0

# Enables GET/POST /api/cron for an external scheduler (cron-job.org etc.)
# CRON_SECRET=
# Set to false if you only want the external cron to drive publishing
# SCHEDULER_ENABLED=true

# Nepali Patro rashifal API (used with permission — credit is always shown)
# RASHIFAL_API_URL=https://nepalipatro.com.np/rashifal/getv5/type/dwmy

# Open-Meteo commercial API key (optional; the free API needs no key)
# OPEN_METEO_API_KEY=
